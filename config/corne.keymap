#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

/ {
    combos {
        compatible = "zmk,combos";

        screen {
            bindings = <&kp PRINTSCREEN>;
            key-positions = <35 34>;
        };

        langv {
            bindings = <&kp LG(SPACE)>;
            key-positions = <16 15>;
        };
    };

    macros {
        my_pass: new_macro {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp A &kp N1 &kp Q &kp A &kp Z &kp AT &kp LS(W) &kp LS(S) &kp LS(X) &kp N3 &kp E &kp D &kp C &kp DLLR &kp LS(R) &kp LS(F) &kp LS(V) &kp EXCL &kp AT &kp POUND &kp DLLR>;
            label = "NEW_MACRO";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            // -----------------------------------------------------------------------------------------
            // |  TAB |  Q  |  W  |  E  |  R  |  T  |   |  Y  |  U   |  I  |  O  |  P  | BKSP |
            // | CTRL |  A  |  S  |  D  |  F  |  G  |   |  H  |  J   |  K  |  L  |  ;  |  '   |
            // | SHFT |  Z  |  X  |  C  |  V  |  B  |   |  N  |  M   |  ,  |  .  |  /  | ESC  |
            //                    | GUI | LWR | SPC |   | ENT | RSE  | ALT |

            bindings = <
&kp TAB        &kp Q  &kp W  &kp E                      &kp R           &kp T        &kp Y    &kp U  &kp I      &kp O    &kp P     &kp LEFT_BRACE
&kp BACKSPACE  &kp A  &kp S  &kp D                      &kp F           &kp G        &kp H    &kp J  &kp K      &kp L    &kp SEMI  &kp SQT
&kp DELETE     &kp Z  &kp X  &kp C                      &kp V           &kp B        &kp N    &kp M  &kp COMMA  &kp DOT  &kp FSLH  &kp RIGHT_BRACE
                             &mt LEFT_CONTROL LEFT_GUI  &kp LEFT_SHIFT  &kp SPACE    &kp RET  &mo 1  &kp RALT
            >;
        };

        lower_layer {
            // -----------------------------------------------------------------------------------------
            // |  TAB |  1  |  2  |  3  |  4  |  5  |   |  6  |  7  |  8  |  9  |  0  | BKSP |
            // | BTCLR| BT1 | BT2 | BT3 | BT4 | BT5 |   | LFT | DWN |  UP | RGT |     |      |
            // | SHFT |     |     |     |     |     |   |     |     |     |     |     |      |
            //                    | GUI |     | SPC |   | ENT |     | ALT |

            bindings = <
&kp GRAVE  &kp N1        &kp N2     &kp N3     &kp N4  &kp N5    &bt BT_SEL 0  &none           &kp UP_ARROW  &none      &none    &my_pass
&none      &kp NUMBER_6  &kp N7     &kp N8     &kp N9  &kp N0    &bt BT_SEL 1  &kp LEFT_ARROW  &kp DOWN      &kp RIGHT  &none    &none
&none      &kp MINUS     &kp EQUAL  &kp SLASH  &none   &none     &bt BT_SEL 2  &none           &none         &none      &kp DOT  &studio_unlock
                                    &mo 2      &trans  &trans    &trans        &none           &trans
            >;
        };

        raise_layer {
            // -----------------------------------------------------------------------------------------
            // |  TAB |  !  |  @  |  #  |  $  |  %  |   |  ^  |  &  |  *  |  (  |  )  | BKSP |
            // | CTRL |     |     |     |     |     |   |  -  |  =  |  [  |  ]  |  \  |  `   |
            // | SHFT |     |     |     |     |     |   |  _  |  +  |  {  |  }  | "|" |  ~   |
            //                    | GUI |     | SPC |   | ENT |     | ALT |

            bindings = <
&none  &kp F1   &kp F2   &kp F3        &kp F4  &kp F5     &none   &mkp LCLK       &mmv MOVE_UP    &mkp RCLK        &none  &bt BT_CLR_ALL
&none  &kp F6   &kp F7   &kp F8        &kp F9  &kp F10    &none   &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_RIGHT  &none  &bt BT_CLR
&none  &kp F11  &kp F12  &none         &none   &none      &none   &none           &mkp MCLK       &none            &none  &none
                         &kp LEFT_GUI  &trans  &trans     &trans  &mo 3           &trans
            >;
        };

        layer_3 {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
                        &trans  &trans  &trans    &trans  &trans  &trans
            >;
        };
    };
};
